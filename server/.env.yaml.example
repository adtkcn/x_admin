# 具体配置项参考：config\config.go的config结构体

# 项目端口
APP:
  GinMode: 'debug'
  Version: '2.0.0'
  Port: 8080

# 数据库
DB:
  Dsn: 'root:123456789@tcp(localhost:3306)/x_admin_2?charset=utf8mb4&parseTime=True&loc=Local'
  LogLevel: 'info'
#Redis
REDIS:
  Url: 'redis://localhost:6379'
  # Redis键前缀: x:如果多个基于此项目使用同一个redis，应该更改前缀
  RedisPrefix: "x:"

# 上传文件目录
FILE:
  UploadDirectory:'./uploads/'

# JWT (web 端用户系统)
JWT:
  AccessSecret: 'x_admin_jwt_web_access_secret_change_me'
  RefreshSecret: 'x_admin_jwt_web_refresh_secret_change_me'
  AccessExpireSec: 7200   # access_token 有效期(秒) 2小时
  RefreshExpireSec: 604800 # refresh_token 有效期(秒) 7天

# JWT (后台管理 admin，与 web 端密钥分离)
AdminJWT:
  AccessSecret: 'x_admin_jwt_admin_access_secret_change_me'
  RefreshSecret: 'x_admin_jwt_admin_refresh_secret_change_me'
  AccessExpireSec: 7200   # access_token 有效期(秒) 2小时
  RefreshExpireSec: 604800 # refresh_token 有效期(秒) 7天
# 个推
GeTui:
  Host: ''
  AppID: ''
  AppKEY: ''
  AppSECRET: ''
  MasterSecret: ''
  PackName: ''

# Email：多个邮件
EMAIL:
  - Host: 'smtp.qq.com'
    Port: 465
    SSL: true
    Username: ''
    Password: ''
    Timeout: 10
  - Host: 'smtp.qq.com'
    Port: 465
    SSL: true
    Username: ''
    Password: ''
    Timeout: 10
# IoT 设备接入层与数据处理层
IOT:
  Enable: true            # 接入层总开关：false 时不注册设备侧路由、不启动处理流水线
  # 离线判定时长不再有全局配置：只取产品/设备的 offline_timeout 字段（设备>产品，两者均为 0 时兜底 300 秒）
  DeviceCacheTTL: 300     # 设备鉴权信息缓存(秒)，避免每条报文查库
  ThingCacheTTL: 600      # 物模型缓存(秒)
  StateTTL: 86400         # 设备最新属性快照保留(秒)
  MaxValues: 50           # 单次上报最大属性条数
  PushStateChange: true   # 在线状态变化时经 core.Ws 广播
  LogRaw: false           # 是否记录原始报文日志(联调期打开)
  LogRuleChain: false     # 是否逐节点记录规则链执行日志：进入/携带参数/输出参数(联调期打开)
  DataBatchSize: 200      # 时序历史批量写入单批行数(攒满或2秒落库一次)
  DataKeepDays: 30        # 时序历史保留天数，每天3点清理；0=永久保留
