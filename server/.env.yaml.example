# 具体配置项参考：config\config.go的config结构体

# 项目端口
APP:
  GinMode: 'debug'
  Version: '2.0.0'
  Port: 8080

# 数据库
DB:
  Dsn: 'root:123456789@tcp(localhost:3306)/x_admin_2?charset=utf8mb4&parseTime=True&loc=Local'
  LogLevel: 'info'
#Redis
REDIS:
  Url: 'redis://localhost:6379'
  # Redis键前缀: x:如果多个基于此项目使用同一个redis，应该更改前缀
  RedisPrefix: "x:"

# 上传文件目录
FILE:
  UploadDirectory: '/www/wwwroot/x_admin_go/public/uploads/'
# 个推
GeTui:
  Host: ''
  AppID: ''
  AppKEY: ''
  AppSECRET: ''
  MasterSecret: ''
  PackName: ''

# Email：多个邮件
EMAIL:
  - Host: 'smtp.qq.com'
    Port: 465
    SSL: true
    Username: ''
    Password: ''
    Timeout: 10
  - Host: 'smtp.qq.com'
    Port: 465
    SSL: true
    Username: ''
    Password: ''
    Timeout: 10